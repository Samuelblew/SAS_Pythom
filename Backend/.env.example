MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=ias_dev
JWT_SECRET=ias-dev-jwt-secret-change-in-production-32chars
JWT_ISSUER=IAS.Dev
JWT_AUDIENCE=IAS.Api
JWT_EXPIRATION_HOURS=8
ENVIRONMENT=Development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AWS RDS / Elastic Beanstalk também aceita RDS_HOSTNAME, RDS_PORT,
# RDS_USERNAME, RDS_PASSWORD, RDS_DB_NAME.
# MYSQL_SSL=true  (ligado automaticamente se o host não for localhost)
